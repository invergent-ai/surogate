+#if defined(__AVX512F__)
+// Two conditioning lanes share weights. Retain the reference dot product's
+// four accumulators and reduction order, but load each weight vector once.
+static bool ggml_cpu_mul_mat_pair_f32(const struct ggml_compute_params *params, struct ggml_tensor *dst) {
+    const struct ggml_tensor *w = dst->src[0];
+    const struct ggml_tensor *x = dst->src[1];
+    const int64_t k = w->ne[0], rows = w->ne[1];
+    if (params->use_ref || w->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32 ||
+        dst->type != GGML_TYPE_F32 || w->ne[2] != 1 || w->ne[3] != 1 || x->ne[1] * x->ne[2] * x->ne[3] != 2 ||
+        k < 64 || k % 64 || w->nb[0] != sizeof(float) || x->nb[0] != sizeof(float) ||
+        dst->nb[0] != sizeof(float))
+        return false;
+    const int dim = x->ne[1] == 2 ? 1 : x->ne[2] == 2 ? 2 : 3;
+    const float *x0 = (const float *)x->data;
+    const float *x1 = (const float *)((const char *)x->data + x->nb[dim]);
+    float *y0 = (float *)dst->data;
+    float *y1 = (float *)((char *)dst->data + dst->nb[dim]);
+    const int64_t begin = rows * params->ith / params->nth;
+    const int64_t end = rows * (params->ith + 1) / params->nth;
+    for (int64_t r = begin; r < end; ++r) {
+        const float *weight = (const float *)((const char *)w->data + r * w->nb[1]);
+        __m512 a0 = _mm512_setzero_ps(), a1 = a0, a2 = a0, a3 = a0;
+        __m512 b0 = a0, b1 = a0, b2 = a0, b3 = a0;
+        for (int64_t i = 0; i < k; i += 64) {
+            const __m512 w0 = _mm512_loadu_ps(weight + i);
+            const __m512 w1 = _mm512_loadu_ps(weight + i + 16);
+            const __m512 w2 = _mm512_loadu_ps(weight + i + 32);
+            const __m512 w3 = _mm512_loadu_ps(weight + i + 48);
+            a0 = _mm512_fmadd_ps(w0, _mm512_loadu_ps(x0 + i), a0);
+            a1 = _mm512_fmadd_ps(w1, _mm512_loadu_ps(x0 + i + 16), a1);
+            a2 = _mm512_fmadd_ps(w2, _mm512_loadu_ps(x0 + i + 32), a2);
+            a3 = _mm512_fmadd_ps(w3, _mm512_loadu_ps(x0 + i + 48), a3);
+            b0 = _mm512_fmadd_ps(w0, _mm512_loadu_ps(x1 + i), b0);
+            b1 = _mm512_fmadd_ps(w1, _mm512_loadu_ps(x1 + i + 16), b1);
+            b2 = _mm512_fmadd_ps(w2, _mm512_loadu_ps(x1 + i + 32), b2);
+            b3 = _mm512_fmadd_ps(w3, _mm512_loadu_ps(x1 + i + 48), b3);
+        }
+        y0[r] = _mm512_reduce_add_ps(_mm512_add_ps(_mm512_add_ps(a0, a2), _mm512_add_ps(a1, a3)));
+        y1[r] = _mm512_reduce_add_ps(_mm512_add_ps(_mm512_add_ps(b0, b2), _mm512_add_ps(b1, b3)));
