[Unit]
Description=Rune v3 NVFP4 decisions API
Requires=docker.service
After=docker.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/etc/rune-v3/run-engine.sh
ExecStop=/usr/bin/docker stop --time 30 rune-v3
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=process

[Install]
WantedBy=multi-user.target
