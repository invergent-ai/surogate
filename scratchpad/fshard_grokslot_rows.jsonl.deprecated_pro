{"task_id": "lcbv6__abc392_f", "arm": "solo__st_gpt", "cap": "unit_code", "score": 1.0, "status": "ok", "answer": "```python\nimport sys\n\n\nclass Fenwick:\n    def __init__(self, n):\n        self.n = n\n        self.bit = [0] * (n + 1)\n\n    def add(self, i, x):\n        n = self.n\n        while i <= n:\n            self.bit[i] += x\n            i += i & -i\n\n    def kth(self, k):\n        idx = 0\n        step = 1 << (self.n.bit_length() - 1)\n        while step:\n            nxt = idx + step\n            if nxt <= self.n and self.bit[nxt] < k:\n                idx = nxt\n                k -= self.bit[nxt]\n            step >>= 1\n        return idx + 1\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    n = data[0]\n    p = data[1:]\n\n    fw = Fenwick(n)\n    for i in range(1, n + 1):\n        fw.add(i, 1)\n\n    ans = [0] * n\n    for value in range(n, 0, -1):\n        pos = fw.kth(p[value - 1])\n        ans[pos - 1] = value\n        fw.add(pos, -1)\n\n    print(*ans)\n\n\nif __name__ == \"__main__\":\n    main()\n```", "finish": "stop"}
{"task_id": "lcbv6__arc194_b", "arm": "solo__st_gpt", "cap": "unit_code", "score": 1.0, "status": "ok", "answer": "```python\nimport sys\n\n\nclass Fenwick:\n    def __init__(self, n):\n        self.n = n\n        self.bit = [0] * (n + 1)\n\n    def add(self, index, value):\n        while index <= self.n:\n            self.bit[index] += value\n            index += index & -index\n\n    def sum(self, index):\n        total = 0\n        while index > 0:\n            total += self.bit[index]\n            index -= index & -index\n        return total\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    n = data[0]\n    p = data[1:]\n\n    pos = [0] * (n + 1)\n    for i, value in enumerate(p, 1):\n        pos[value] = i\n\n    fenwick = Fenwick(n)\n    for i in range(1, n + 1):\n        fenwick.add(i, 1)\n\n    answer = 0\n\n    for value in range(n, 0, -1):\n        current_pos = fenwick.sum(pos[value])\n        distance = value - current_pos\n        answer += (current_pos + value - 1) * distance // 2\n        fenwick.add(pos[value], -1)\n\n    print(answer)\n\n\nif __name__ == \"__main__\":\n    main()\n```", "finish": "stop"}
{"task_id": "lcbv6__abc392_f", "arm": "solo__st_gemini", "cap": "unit_code", "score": 1.0, "status": "ok", "answer": "```python\nimport sys\n\ndef solve():\n    # Read all tokens from standard input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    N = int(input_data[0])\n    P = [int(x) for x in input_data[1:N+1]]\n    \n    # Initialize a Fenwick tree (Binary Indexed Tree) with 1s\n    # bit[i] will store the number of available slots in the interval (i - (i & -i), i]\n    bit = [0] * (N + 1)\n    for i in range(1, N + 1):\n        bit[i] += 1\n        nxt = i + (i & -i)\n        if nxt <= N:\n            bit[nxt] += bit[i]\n            \n    ans = [0] * N\n    \n    # Find the maximum power of 2 such that (1 << max_pow) <= N\n    max_pow = 0\n    while (1 << max_pow) <= N:\n        max_pow += 1\n    max_pow -= 1\n    \n    # Precompute powers of 2 for binary lifting\n    powers = [1 << j for j in range(max_pow, -1, -1)]\n    \n    # Process elements in reverse order\n    for i in range(N - 1, -1, -1):\n        k = P[i]\n        idx = 0\n        \n        # Binary lifting to find the k-th available slot\n        for step in powers:\n            next_idx = idx + step\n            if next_idx <= N and bit[next_idx] < k:\n                idx = next_idx\n                k -= bit[idx]\n        \n        pos = idx + 1\n        ans[pos - 1] = i + 1\n        \n        # Mark the chosen slot as unavailable by updating the Fenwick tree\n        curr = pos\n        while curr <= N:\n            bit[curr] -= 1\n            curr += curr & -curr\n            \n    # Print the final array separated by spaces\n    ", "finish": "stop"}
